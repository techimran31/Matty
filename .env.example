# ---------------------------------------------------------------------------
# Matty - environment file
# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
# ".env" is git-ignored, so your keys never leave this machine.
#
#   copy .env.example .env        (Windows)
#   cp .env.example .env          (macOS / Linux)
#
# Or just click the KEY button in the HUD and paste the key there.
# ---------------------------------------------------------------------------

# Free Groq API key - https://console.groq.com/keys
# Used for: cloud answers, multilingual speech-to-text (Whisper)
GROQ_API_KEY=

# Optional: force a speech-recognition language instead of auto-detecting.
# Leave empty/commented for automatic detection of any language.
# Examples: en-US, hi-IN, es-ES, ar-SA, zh-CN
# MATTY_LANG=

# Optional: set to 0 to disable interrupting Matty while it is speaking.
# MATTY_BARGE_IN=1
